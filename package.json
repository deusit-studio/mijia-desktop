{
  "name": "mijia-desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 concurrently \"pnpm --filter . run dev:renderer\" \"pnpm --filter . run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build:renderer": "vite build",
    "build": "pnpm run build:renderer && electron-builder",
    "start": "electron ."
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.0.0",
    "electron": "^26.0.0",
    "electron-builder": "^24.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "wait-on": "^7.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "pinia": "^2.0.0",
    "tdesign-icons-vue-next": "^0.3.0",
    "tdesign-vue-next": "^0.40.0",
    "vue": "^3.3.0",
    "vue-i18n": "^9.2.0",
    "vue-router": "^4.2.0"
  },
  "build": {
    "appId": "com.deusit.mijia",
    "files": ["dist/**", "electron.main.js", "preload/**", "package.json"],
    "directories": { "buildResources": "build" }
  }
}
